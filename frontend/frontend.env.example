# Copy to frontend/.env and fill in, then restart `npm run dev`
VITE_API_BASE=http://localhost:8000

# Supabase project - same project as the backend's SUPABASE_URL, but the
# PUBLIC anon key (not the service-role key used by the backend). This is
# safe to expose in the frontend: Supabase Auth signup/login only need
# the anon key, and the backend independently verifies every access
# token before trusting it - see backend/app/services/auth.py.
VITE_SUPABASE_URL=https://lgtsqnkuseopbtuiujug.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ZvTmwQWdqt6KExve6ENXeA_MuZk5i7u
